NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=cbt_system

# REQUIRED. Two DIFFERENT random strings, 32+ characters each.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Frontend URL(s) allowed to call the API (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# Refresh-token cookie. Frontend + API on the same site (e.g. app.school.com / api.school.com): keep strict.
# Different sites (e.g. vercel.app + onrender.com): COOKIE_SAMESITE=none (requires HTTPS / COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
# COOKIE_SECURE=true          # defaults to true when NODE_ENV=production
TRUST_PROXY=0                 # set to 1 behind nginx / a hosting proxy so rate limits see real client IPs

# School-local UTC offset used for exam dates/times (Nigeria = +01:00)
SCHOOL_TZ_OFFSET=+01:00

# OPTIONAL: AI extraction for PDF/Word question import (a rule-based parser is used otherwise)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
